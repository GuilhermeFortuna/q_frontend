# HTTP API (q_backend FastAPI — use localhost:8000 when backend runs in Docker)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Enable MSW mock API in the browser (default: true in dev).
# Set to false when using a real backend (native or Docker).
VITE_ENABLE_MSW=true

# Show the developer performance HUD (FPS, long tasks, canvas/query counts).
# VITE_PERF_HUD=true

# Sentry is dormant unless a DSN is supplied. MSW-enabled development sessions never report.
# VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
# VITE_SENTRY_RELEASE is stamped by the release workflow (WO206).
