{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quant",
  "version": "0.1.0",
  "identifier": "com.quant.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quant",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../q_backend/src/**/*",
      "../../q_backend/alembic/**/*",
      "../../q_backend/pyproject.toml",
      "../../q_backend/uv.lock",
      "../../q_backend/alembic.ini",
      "../../q_backend/docker-compose.yml",
      "../../q_backend/.env.example"
    ]
  }
}
